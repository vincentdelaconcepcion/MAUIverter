<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIverter.MainPage"
             BackgroundColor="#FF0BDC0B">

    <ContentPage.Resources>
        <Style x:Key="HeaderLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CategoryLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalTextAlignment" Value="End"/>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Label Text="- MAUIVERTER -"
               Style="{StaticResource HeaderLabel}"
               Margin="0,40,0,20"/>

        <!-- Grid Background with gradient -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="4"
              RowSpacing="4"
              Padding="4">

            <!-- Row 0 -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Border BackgroundColor="#FFE4FF17" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Information" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Information"
                        Clicked="OnInformationClicked"/>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1">
                <Border BackgroundColor="Red" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Volume" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Volume"
                        Clicked="OnVolumeClicked"/>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="2">
                <Border BackgroundColor="blue" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Length" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Length"
                        Clicked="OnLengthClicked"/>
            </Grid>

            <!-- Row 1 -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Border BackgroundColor="Yellow" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Mass" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Mass"
                        Clicked="OnMassClicked"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <Border BackgroundColor="Red" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Temperature" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Temperature"
                        Clicked="OnTemperatureClicked"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2">
                <Border BackgroundColor="Blue" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Energy" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Energy"
                        Clicked="OnEnergyClicked"/>
            </Grid>

            <!-- Row 2 -->
            <Grid Grid.Row="2" Grid.Column="0">
                <Border BackgroundColor="Yellow" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Area" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Area"
                        Clicked="OnAreaClicked"/>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1">
                <Border BackgroundColor="Red" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Speed" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Speed"
                        Clicked="OnSpeedClicked"/>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="2">
                <Border BackgroundColor="Blue" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="&#xe707;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="Duration" Style="{StaticResource CategoryLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Button Style="{StaticResource TileButton}"
                        SemanticProperties.Description="Duration"
                        Clicked="OnDurationClicked"/>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
