<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIverter.LengthPage"
             Title="Length">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">

            <Label Text="Length Converter"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Label Text="From" FontAttributes="Bold" />
            <Picker x:Name="FromPicker"
                    Title="Choose a unit"
                    SelectedIndexChanged="OnUnitChanged" />

            <Label Text="Amount" FontAttributes="Bold" />
            <Entry x:Name="ValueEntry"
                   Keyboard="Numeric"
                   Placeholder="Enter a number"
                   TextChanged="OnValueTextChanged" />

            <Label Text="To" FontAttributes="Bold" />
            <Picker x:Name="ToPicker"
                    Title="Choose a unit"
                    SelectedIndexChanged="OnUnitChanged" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                <Button Grid.Column="0" Text="Convert" Clicked="OnConvertClicked" />
                <Button Grid.Column="1" Text="Swap" Clicked="OnSwapClicked" />
            </Grid>

            <Border Margin="0,6,0,0"
                    Padding="16"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="ResultLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="EquationLabel"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
