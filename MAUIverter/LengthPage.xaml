<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIverter.LengthPage"
             Title="Length"
             BackgroundColor="#FFF4F6FB">

    <ContentPage.Resources>
        <Style x:Key="StepLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#FF52606D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Stroke" Value="#FFDCE3EC"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="BackgroundColor" Value="White"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Length Converter" FontSize="30" FontAttributes="Bold" TextColor="#FF1F2933"/>
            <Label Text="How long or tall is it?" FontSize="16" TextColor="#FF52606D" Margin="0,0,0,8"/>

            <Label Text="1. What are you converting FROM?" Style="{StaticResource StepLabel}"/>
            <Border Style="{StaticResource Card}">
                <Picker x:Name="FromPicker" FontSize="22" TextColor="#FF1F2933"
                        Title="Pick a unit"
                        SelectedIndexChanged="OnUnitChanged"/>
            </Border>

            <Label Text="2. How much?" Style="{StaticResource StepLabel}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Card}">
                <Entry x:Name="ValueEntry" FontSize="30" TextColor="#FF1F2933"
                       Placeholder="0" PlaceholderColor="#FF9AA5B1"
                       Keyboard="Numeric" HorizontalTextAlignment="Center"
                       TextChanged="OnValueTextChanged"/>
            </Border>

            <Button Text="Swap units" Clicked="OnSwapClicked"
                    BackgroundColor="White" TextColor="#FF8B5CF6"
                    BorderColor="#FF8B5CF6" BorderWidth="2"
                    CornerRadius="16" FontSize="18" FontAttributes="Bold"
                    HeightRequest="50" Margin="0,4,0,0"/>

            <Label Text="3. Convert it TO" Style="{StaticResource StepLabel}" Margin="0,6,0,0"/>
            <Border Style="{StaticResource Card}">
                <Picker x:Name="ToPicker" FontSize="22" TextColor="#FF1F2933"
                        Title="Pick a unit"
                        SelectedIndexChanged="OnUnitChanged"/>
            </Border>

            <Button Text="Convert!" Clicked="OnConvertClicked"
                    BackgroundColor="#FF8B5CF6" TextColor="White"
                    CornerRadius="16" FontSize="20" FontAttributes="Bold"
                    HeightRequest="56" Margin="0,4,0,0"/>

            <Border x:Name="ResultCard" Margin="0,10,0,0" Padding="18"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#FF8B5CF6" StrokeThickness="2"
                    BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="ResultLabel" FontSize="34" FontAttributes="Bold"
                           TextColor="#FF1F2933" HorizontalTextAlignment="Center"/>
                    <Label x:Name="EquationLabel" FontSize="15" TextColor="#FF52606D"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                <Label Text="Size check" FontSize="18" FontAttributes="Bold" TextColor="#FF1F2933"/>
                <Label Text="Here is one of each. The longer bar is the bigger unit."
                       FontSize="13" TextColor="#FF52606D"/>
                <Label x:Name="FromSizeLabel" FontSize="15" FontAttributes="Bold" TextColor="#FF1F2933"/>
                <ProgressBar x:Name="FromSizeBar" ProgressColor="#FF8B5CF6" HeightRequest="18"/>
                <Label x:Name="ToSizeLabel" FontSize="15" FontAttributes="Bold" TextColor="#FF1F2933" Margin="0,10,0,0"/>
                <ProgressBar x:Name="ToSizeBar" ProgressColor="#FF94A3B8" HeightRequest="18"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
